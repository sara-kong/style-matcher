{
  "manifest_version": 3,
  "name": "Taste Score",
  "version": "0.3.0",
  "description": "Scores clothing images on any shopping page with your own taste model, running on your laptop.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Taste Score"
  }
}